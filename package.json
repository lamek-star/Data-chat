{
  "name": "datachat",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite\" \"wrangler dev --port 4242 --local\"",
    "dev:client": "vite",
    "build": "vite build",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "worker:dev": "npm run build && wrangler dev",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync",
    "android:open": "npm run mobile:sync && cap open android",
    "ios:open": "npm run mobile:sync && cap open ios",
    "dev:offline": "vite --mode offline",
    "test": "vitest run",
    "dev:api": "wrangler dev --port 4242 --local",
    "db:migrate:local": "wrangler d1 migrations apply datachat --local"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "framer-motion": "12.43.0",
    "html5-qrcode": "2.3.8",
    "lucide-react": "1.67.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "9.2.5",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "vite": "8.3.5",
    "vitest": "3.2.7",
    "wrangler": "4.157.0"
  }
}
